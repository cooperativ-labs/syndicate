{
  "name": "permissioned-exchange",
  "version": "1.0.0",
  "private": true,
  "author": "Cooperativ Labs. Inc",
  "license": "ISC",
  "scripts": {
    "start": "supabase start",
    "stop": "supabase stop",
    "new": "rm -rf node_modules && yarn cache clean && yarn install && yarn generate ",
    "schema": "curl -X POST localhost:8080/admin/schema --data-binary '@dgraph/schema.graphql'",
    "generate": "sh -c '. ./.env.local && graphql-codegen'",
    "dev": "next dev",
    "build": "next build",
    "generate-staging": "sh -c '. ./staging.env && graphql-codegen'",
    "build-staging": "sh -c '. ./staging.env && graphql-codegen && next build'",
    "generate-production": "sh -c '. ./prod.env && graphql-codegen'",
    "build-production": "sh -c '. ./prod.env && graphql-codegen && next build'",
    "ngrok": "ngrok http --domain=romantic-pig-living.ngrok-free.app 3000",
    "ngrok:server": "ngrok http --domain=romantic-pig-living.ngrok-free.app 54321",
    "prettier": "prettier --write .",
    "lint": "yarn run js-lint && yarn run style-lint && yarn run type-check",
    "fix": "yarn run fix-js-lint && yarn run fix-style-lint",
    "fix-js-lint": "eslint -c eslint.config.mjs --fix './app/**/*.{ts,tsx}' './src/**/*.{ts,tsx}' './contexts/**/*.{ts,tsx}' './hooks/**/*.{ts,tsx}' './supabase/**/*.{ts,tsx}' -f table",
    "js-lint-src": "eslint -c eslint.config.mjs './app/**/*.{ts,tsx}' './src/**/*.{ts,tsx}' './contexts/**/*.{ts,tsx}' './hooks/**/*.{ts,tsx}' './supabase/**/*.{ts,tsx}'  -f table",
    "js-lint-tests": "eslint -c eslint.config.mjs './tests/**/*.{ts,tsx}' -f table",
    "fix-js-lint-tests": "eslint -c eslint.config.mjs --fix './tests/**/*.{ts,tsx}' -f table",
    "fix-style-lint": "stylelint '**/*.css' --fix",
    "js-lint": "yarn run js-lint-src && yarn run js-lint-tests",
    "type-check": "tsc --noEmit",
    "test:unit": "jest"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": false,
    "trailingComma": "none",
    "tabWidth": 2,
    "semi": true,
    "jsxSingleQuote": false,
    "bracketSpacing": true,
    "arrowParens": "avoid",
    "endOfLine": "lf"
  },
